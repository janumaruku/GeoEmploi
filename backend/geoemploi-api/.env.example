DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geoemploi

# Signe les tokens JWT — change cette valeur en prod, et ne la commit jamais
# avec une vraie valeur. Génère-en une avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Optionnels, valeurs par défaut déjà correctes pour du dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
