DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geoemploi
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Service WMTS public de la Géoplateforme IGN et cache local du proxy cartographique.
IGN_WMTS_BASE_URL=https://data.geopf.fr/wmts
IGN_WMTS_LAYER=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2
IGN_WMTS_TIMEOUT_SECONDS=8
MAP_CACHE_DIR=/tmp/geoemploi-map-cache
